{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whatcrow",
  "version": "0.1.0",
  "identifier": "pe.overskull.whatcrow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "whatcrow",
        "width": 330,
        "height": 660,
        "minWidth": 300,
        "minHeight": 360,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
