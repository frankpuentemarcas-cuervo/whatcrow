{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whatcrow",
  "version": "0.1.3",
  "identifier": "pe.overskull.whatcrow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "whatcrow",
        "width": 330,
        "height": 660,
        "minWidth": 300,
        "minHeight": 360,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERDA0OTlBQzVGNTJGNTQKUldSVUwvWEZta25RL1FzeFk0dzFLMi96NGMrUnU4VmZyVGloNXZTZi81K3lGbmVoeGFlZzg2UDYK",
      "endpoints": [
        "https://github.com/frankpuentemarcas-cuervo/whatcrow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
